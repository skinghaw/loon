#!name = 修仙小游戏
#!desc = tg.zifumh.cn 自动签到/俸禄/雇人挖矿/领收成/闭关续挂机。每天打开一次小程序自动更新登录态，任务到点自动执行并推送结果。双修 op 待抓包后开启。
#!author = 你的昵称
#!homepage = https://github.com/skinghaw/loon
#!loon_version = 3.5.1(983)
#!date = 2026-10-28
#!tag = 游戏,签到
#!type = normal

[Argument]
# ===== 任务开关 =====
sign_enable     = switch,true,tag=签到任务
salary_enable   = switch,true,tag=俸禄任务（每周一）
mine_enable     = switch,true,tag=雇人挖矿
collect_enable  = switch,true,tag=领取挖矿收成
meditate_enable = switch,true,tag=闭关任务（出关收收益后续挂机）
dual_enable     = switch,false,tag=双修任务（op待补，默认关闭）
capture_enable  = switch,true,tag=抓包开关（打开游戏时自动更新登录态）

# ===== 定时（分 时 日 月 周） =====
sign_cron     = input,"2 0 * * *",type=string,tag=签到定时
salary_cron   = input,"1 0 * * 1",type=string,tag=俸禄定时（每周一）
mine1_cron    = input,"0 0 * * *",type=string,tag=派矿定时①（0点）
mine2_cron    = input,"3 8 * * *",type=string,tag=派矿定时②（8:03）
collect1_cron = input,"1 8 * * *",type=string,tag=收成定时①（8:01）
collect2_cron = input,"4 16 * * *",type=string,tag=收成定时②（16:04）
med1_cron     = input,"0 0 * * *",type=string,tag=闭关定时①（0点）
med2_cron     = input,"0 8 * * *",type=string,tag=闭关定时②（8点）
med3_cron     = input,"0 16 * * *",type=string,tag=闭关定时③（16点）
dual_cron     = input,"1 0 * * *",type=string,tag=双修定时（op待补）

[Script]
request if ${url} ~= ^https://tg\.zifumh\.cn/api/xiuxian-app\.php then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_capture.js") with enable=${capture_enable}, requires_body=true, tag="修仙·抓包"

cron ${sign_cron}     then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","sign")     with enable=${sign_enable}, timeout=300, tag="修仙·签到"
cron ${salary_cron}   then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","salary")   with enable=${salary_enable}, timeout=300, tag="修仙·俸禄"
cron ${mine1_cron}    then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","mine")     with enable=${mine_enable}, timeout=300, tag="修仙·派矿①"
cron ${mine2_cron}    then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","mine")     with enable=${mine_enable}, timeout=300, tag="修仙·派矿②"
cron ${collect1_cron} then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","collect")  with enable=${collect_enable}, timeout=300, tag="修仙·收成①"
cron ${collect2_cron} then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","collect")  with enable=${collect_enable}, timeout=300, tag="修仙·收成②"
cron ${med1_cron}     then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","meditate") with enable=${meditate_enable}, timeout=300, tag="修仙·闭关①"
cron ${med2_cron}     then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","meditate") with enable=${meditate_enable}, timeout=300, tag="修仙·闭关②"
cron ${med3_cron}     then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","meditate") with enable=${meditate_enable}, timeout=300, tag="修仙·闭关③"
cron ${dual_cron}     then script("https://raw.githubusercontent.com/skinghaw/loon/main/zifumh_task.js","dual")     with enable=${dual_enable}, timeout=300, tag="修仙·双修"

[Mitm]
hostname = tg.zifumh.cn
